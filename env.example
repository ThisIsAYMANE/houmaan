# Database
# Connection string format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL=postgresql://bcgame:bcgame123@127.0.0.1:5432/bcgame?schema=public
POSTGRES_USER=bcgame
POSTGRES_PASSWORD=bcgame123
POSTGRES_DB=bcgame
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# Generate a secure secret: openssl rand -base64 32
NEXTAUTH_SECRET=change-this-to-a-random-secret-in-production

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API Keys (add as needed)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=

# Sports Data API
# Get your API key from: https://www.api-football.com/
# Free tier: 100 requests/day
SPORTS_API_KEY=your-api-key-here
SPORTS_API_URL=https://v3.football.api-sports.io
# Alternative: The Odds API - https://the-odds-api.com/
# ODDS_API_KEY=your-odds-api-key-here

# Game Providers (add as needed)
# PRAGMATIC_PLAY_API_KEY=
# EVOLUTION_API_KEY=

# Payment Providers (add as needed)
# STRIPE_SECRET_KEY=
# COINBASE_API_KEY=

