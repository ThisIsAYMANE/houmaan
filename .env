# ── Bitcoin Payment ──────────────────────────────────────────────────────────
# 32-byte hex seed for Bitcoin HD wallet (BIP32). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: Keep this secret and back it up securely!
BITCOIN_MASTER_SEED=3450d33011e64b4622127219e693e0eb9c6346cb8e947307145d79e77f825b59
BITCOIN_NETWORK=testnet

# ── USDT Payment (EVM: Ethereum / BSC / Polygon) ────────────────────────────
# 12-word BIP39 mnemonic for EVM HD wallet.
# Generate with: node -e "const {ethers}=require('ethers'); console.log(ethers.Wallet.createRandom().mnemonic.phrase)"
# WARNING: Keep this secret and back it up securely!
USDT_MASTER_MNEMONIC=grit harvest include life human wrap wedding office pizza vocal decrease example

# Public RPC endpoints (free tier — replace with your own for production)
ETHEREUM_RPC_URL=https://cloudflare-eth.com
BSC_RPC_URL=https://bsc-dataseed1.binance.org
POLYGON_RPC_URL=https://polygon-rpc.com

# Block-explorer API keys (free registration at etherscan.io / bscscan.com / polygonscan.com)
# Leave empty to use unauthenticated requests (lower rate limits)
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
POLYGONSCAN_API_KEY=