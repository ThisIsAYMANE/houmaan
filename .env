# Database
# Use local data folder for development
SQLITE_DB_PATH=./data/bcgame.db

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# Generate a secure secret: openssl rand -base64 32
NEXTAUTH_SECRET=change-this-to-a-random-secret-in-production

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API Keys (add as needed)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=

# Game Providers (add as needed)
# PRAGMATIC_PLAY_API_KEY=
# EVOLUTION_API_KEY=

# Payment Providers (add as needed)
# STRIPE_SECRET_KEY=
# COINBASE_API_KEY=


